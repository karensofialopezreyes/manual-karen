---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<h2 class="text-slate-800">𓆉 Instalación en Linux</h2>

<h3 class="text-slate-800">Actualizar sistema</h3>

<pre class="bg-[#c4d0d2] p-[15px] rounded-[10px] border-l-4 border-[hsl(214,56%,53%)] overflow-x-auto">
sudo apt update
sudo apt upgrade
</pre>

<h3 class="text-slate-800">Instalar Node.js</h3>

<pre class="bg-[#c4d0d2] p-[15px] rounded-[10px] border-l-4 border-[hsl(214,56%,53%)] overflow-x-auto">
sudo apt install nodejs npm
</pre>

<h3 class="text-slate-800">Crear proyecto Astro</h3>

<pre class="bg-[#c4d0d2] p-[15px] rounded-[10px] border-l-4 border-[hsl(214,56%,53%)] overflow-x-auto">
npm create astro@latest
</pre>

</BaseLayout>
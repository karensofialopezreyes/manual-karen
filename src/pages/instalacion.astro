---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<h2>𓆉 Instalación en Linux</h2>

<h3>Actualizar sistema</h3>

<pre>
sudo apt update
sudo apt upgrade
</pre>

<h3>Instalar Node.js</h3>

<pre>
sudo apt install nodejs npm
</pre>

<h3>Crear proyecto Astro</h3>

<pre>
npm create astro@latest
</pre>

</BaseLayout>